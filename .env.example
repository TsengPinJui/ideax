# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Dify Customer Support & Agent API (Optional, for Dify AI Agent integration)
DIFY_API_KEY="app-your_dify_key_here"
DIFY_CS_API_KEY="app-your_cs_agent_key_here"
DIFY_MARKET_ADVISOR_API_KEY="app-your_market_advisor_key_here"
DIFY_API_BASE_URL="https://api.dify.ai/v1"

# Dify AICRM 24hr Assistant API (Expert CRM & 24hr AI Assistant)
DIFY_AICRM_API_KEY="app-your_aicrm_key_here"
DIFY_AICRM_WEB_URL="https://udify.app/agent/BnAiF81AGw454x0u"

# Dify Explorer API (全網搜職 AI 特助「探險家」)
DIFY_EXPLORER_API_KEY="app-your_explorer_agent_key_here"
DIFY_EXPLORER_WEB_URL="https://udify.app/agent/bEV82Byu5zk9O4Q5"

# Resend API Key for Transactional Emails (Registration & Password Reset)
RESEND_API_KEY="re_your_api_key_here"
# 寄件人與回覆信箱（選填）
MAIL_FROM="IdeaX 創點子團隊 <noreply@ideax.tw>"
MAIL_REPLY_TO="your-inbox@example.com"

# Firebase 服務帳戶金鑰（選填，整份 JSON 或其 base64）。設定後可用驗證碼重設密碼、在歡迎信附上驗證連結
# 請只放在 Vercel 環境變數，切勿提交到 Git
FIREBASE_SERVICE_ACCOUNT=""

# 管理員 Email 白名單（多組以逗號分隔）。該帳號需在 Firebase Authentication 存在並完成 Email 驗證
ADMIN_EMAILS="admin@example.com"

# Vercel Cron 驗證用密鑰（AI 特助每 5 分鐘值班）。在 Vercel 設定一組隨機字串，Vercel 會自動帶入
CRON_SECRET=""
