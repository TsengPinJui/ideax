rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 安全輔助函式 =====
    function isSignedIn() {
      return request.auth != null;
    }
    // 管理員：/admins/{uid}（只能從 Firebase Console 或後端建立）、Custom Claims，
    // 或「已驗證」的管理員 Email（與 Vercel 的 ADMIN_EMAILS 保持一致）
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        request.auth.uid in ['3uFheztxFGUlsLy2hbVHNVFduTK2', 'ZRXZWS8iiPg91CUV6vQrehK6ZW62'] ||
        (request.auth.token.email_verified == true &&
          request.auth.token.email in ['john25893619@gmail.com', 'c502828987@gmail.com'])
      );
    }

    // 管理員名單：任何前端都不能寫入，避免自我提權
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 會員私密資料（實名、Email、電話、銀行帳戶、問卷）：僅本人與管理員可讀寫
    // 本人：登入帳號與會員編號相同，或會員資料的 authUid 是自己
    function ownsUserDoc(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.get('authUid', '') == request.auth.uid)
      );
    }
    match /user_private/{userId} {
      allow read: if isAdmin() || ownsUserDoc(userId) ||
        (isSignedIn() && resource.data.get('authUid', '') == request.auth.uid);
      allow create, update: if isAdmin() || (
        ownsUserDoc(userId) && request.resource.data.get('authUid', request.auth.uid) == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // 1. 業務核心與交易類 (Core Business & Transactions)

    // 是否為某份資料的擁有者：比對 Firebase 帳號欄位，或透過會員資料的 authUid 對照
    function ownsVia(data, authField, appIdField) {
      return isSignedIn() && (
        data.get(authField, '') == request.auth.uid ||
        data.get(appIdField, '') == request.auth.uid ||
        (data.get(appIdField, '') is string && data.get(appIdField, '') != '' &&
          exists(/databases/$(database)/documents/users/$(data.get(appIdField, ''))) &&
          get(/databases/$(database)/documents/users/$(data.get(appIdField, ''))).data.get('authUid', '') == request.auth.uid)
      );
    }
    // 會員編號是不是自己的：編號就是登入帳號，或該會員資料的 authUid 是自己
    function ownsAppId(appId) {
      return isSignedIn() && appId is string && appId != '' && (
        appId == request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(appId)) &&
          get(/databases/$(database)/documents/users/$(appId)).data.get('authUid', '') == request.auth.uid)
      );
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 問題／提案／作品：所有人可讀；只有發布者能改內容；其他會員只能改互動欄位（按讚、瀏覽、打賞等）
    function protectedQuestionFields() {
      return ['authorId', 'authorAuthUid', 'authorName', 'authorAvatar', 'title', 'description', 'bounty',
              'withheldBounty', 'postType', 'level', 'deadline', 'phases', 'isOfficial', 'publishIdentity',
              'status', 'isFeatured', 'disputeStatus', 'appName', 'youtubeUrl', 'coverImage', 'galleryImages',
              'demoUrl', 'previewMode', 'fileUrl', 'updateLogs', 'specialZone', 'isStarSeason', 'isDelisted',
              'externalLink', 'fileLink', 'techArchitecture', 'publishedPlatforms', 'mindMap'];
    }
    match /questions/{questionId} {
      allow read: if true;
      // 新發布：作者必須是自己的會員帳號；官方身分、精選只有管理員能設定
      allow create: if isAdmin() || (
        isSignedIn() && request.resource.data.get('authorAuthUid', '') == request.auth.uid &&
        ownsAppId(request.resource.data.get('authorId', '')) &&
        request.resource.data.get('isOfficial', false) != true &&
        request.resource.data.get('isFeatured', false) != true &&
        request.resource.data.get('publishIdentity', '') != 'platform'
      );
      allow update: if isAdmin() || (
        ownsVia(resource.data, 'authorAuthUid', 'authorId') &&
        (!('authorAuthUid' in changedKeys()) || request.resource.data.authorAuthUid == request.auth.uid) &&
        !('authorId' in changedKeys()) &&
        !('isOfficial' in changedKeys() && request.resource.data.isOfficial == true) &&
        !('isFeatured' in changedKeys() && request.resource.data.isFeatured == true) &&
        !('publishIdentity' in changedKeys() && request.resource.data.publishIdentity == 'platform')
      ) || (
        isSignedIn() && !changedKeys().hasAny(protectedQuestionFields())
      );
      allow delete: if isAdmin() || ownsVia(resource.data, 'authorAuthUid', 'authorId');
    }

    // 解答：所有人可讀（付費內容保護另案處理）；只有回答者能改內容；
    // 提問者可採納、評分、驗收階段；其他會員只能改互動欄位
    function answerContentFields() {
      return ['solverId', 'solverAuthUid', 'solverName', 'questionId', 'freePreview', 'fullContent',
              'attachments', 'meetingDetails', 'price', 'isPaid', 'type', 'unlockedByUserIds', 'hasProtectedContent'];
    }
    // 付費解答的完整內容不可放在公開文件（應存於 answer_secrets）
    function noPublicPaidContent(d) {
      return d.get('type', 'solution') == 'discussion' || d.get('isPaid', true) == false ||
        d.get('price', 0) <= 0 || d.get('fullContent', '') == '';
    }
    function isQuestionOwnerOf(questionId) {
      return exists(/databases/$(database)/documents/questions/$(questionId)) &&
        ownsVia(get(/databases/$(database)/documents/questions/$(questionId)).data, 'authorAuthUid', 'authorId');
    }
    match /answers/{answerId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() && request.resource.data.get('solverAuthUid', '') == request.auth.uid &&
        ownsAppId(request.resource.data.get('solverId', '')) &&
        noPublicPaidContent(request.resource.data) &&
        request.resource.data.get('unlockedByUserIds', []).size() == 0
      );
      allow update: if isAdmin() || (
        ownsVia(resource.data, 'solverAuthUid', 'solverId') &&
        noPublicPaidContent(request.resource.data) &&
        (!('solverAuthUid' in changedKeys()) || request.resource.data.solverAuthUid == request.auth.uid) &&
        !('solverId' in changedKeys())
      ) || (
        isSignedIn() && !changedKeys().hasAny(answerContentFields()) && isQuestionOwnerOf(resource.data.questionId)
      ) || (
        isSignedIn() && !changedKeys().hasAny(answerContentFields().concat(['isAccepted', 'phases', 'rating', 'reviewComment']))
      );
      allow delete: if isAdmin() || ownsVia(resource.data, 'solverAuthUid', 'solverId');
    }

    // 付費解答的完整內容：回答者本人可讀寫；其他人一律經由伺服器依付款／解鎖紀錄取得
    function ownsAnswer(answerId) {
      return exists(/databases/$(database)/documents/answers/$(answerId)) &&
        ownsVia(get(/databases/$(database)/documents/answers/$(answerId)).data, 'solverAuthUid', 'solverId');
    }
    match /answer_secrets/{answerId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('solverAuthUid', '') == request.auth.uid);
      allow create: if isAdmin() || (
        isSignedIn() && request.resource.data.get('solverAuthUid', '') == request.auth.uid && ownsAnswer(answerId)
      );
      allow update: if isAdmin() || (
        isSignedIn() && request.resource.data.get('solverAuthUid', '') == request.auth.uid &&
        (resource.data.get('solverAuthUid', '') == null || resource.data.get('solverAuthUid', '') == '' ||
          resource.data.get('solverAuthUid', '') == request.auth.uid) &&
        ownsAnswer(answerId)
      );
      allow delete: if isAdmin();
    }

    // 吉祥物互動統計：只有伺服器能寫；管理員可讀
    match /mascot_stats/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 撥款申請：只有伺服器能寫；管理員可讀
    match /payout_requests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 創星季私密資料（聯絡電話、身分證字號、銀行帳號、帳戶點數、報名資料等）：只有伺服器能寫；管理員可讀
    match /competition_private_submissions/{id} { allow read: if isAdmin(); allow write: if false; }
    match /competition_accounts/{id} { allow read: if isAdmin(); allow write: if false; }
    match /competition_participant_registrations/{id} { allow read: if isAdmin(); allow write: if false; }
    match /competition_judge_applications/{id} { allow read: if isAdmin(); allow write: if false; }
    match /competition_support_records/{id} { allow read: if isAdmin(); allow write: if false; }
    match /competition_audit_logs/{id} { allow read: if isAdmin(); allow write: if false; }

    // 交易紀錄：只有交易相關人（partyAuthUids）與管理員能讀
    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.partyAuthUids);
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid in request.resource.data.get('partyAuthUids', []));
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid in request.resource.data.get('partyAuthUids', []) &&
        (request.auth.uid in resource.data.get('partyAuthUids', []) || !('partyAuthUids' in resource.data))
      );
      allow delete: if isAdmin();
    }

    // 私訊：只有對話雙方（participantAuthUids）與管理員能讀寫
    match /conversations/{convId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participantAuthUids);
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid in request.resource.data.get('participantAuthUids', []));
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid in request.resource.data.get('participantAuthUids', []) &&
        (request.auth.uid in resource.data.get('participantAuthUids', []) || !('participantAuthUids' in resource.data))
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.get('participantAuthUids', []));
    }

    // 2. 用戶身分與審核治理類 (Identity, Verification & Governance)
    // 點數帳本與預扣紀錄：只有伺服器（服務帳戶）能寫；管理員可讀
    match /points_ledger/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /points_escrow/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 會員資料：所有人可讀；點數與權限欄位只能由伺服器帳本（服務帳戶）或管理員異動
    function protectedUserFields() {
      return ['balance', 'withheldPoints', 'pendingEarnings', 'tipReceivablesPoints', 'bountyReceivablesPoints', 'thisWeekTipPoints',
              'totalWithdrawn', 'isBlocked', 'blockedReason', 'blockedUntil', 'blockedAt', 'blockedByAdminName',
              'adminSites', 'isSiteAAdmin', 'isSiteBAdmin', 'adminIdentityBadge', 'isInitialAdmin',
              'subscriptionTier', 'subscriptionExpiresAt'];
    }
    // 身分欄位：只有本人能改
    function identityUserFields() {
      return ['name', 'avatar', 'email', 'username', 'phone', 'bio', 'title', 'authUid', 'memberId',
              'accountType', 'role', 'realNameAuthStatus', 'expertCertStatus', 'verifiedExpert'];
    }
    function isUserOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.get('authUid', '') == request.auth.uid ||
        ('email' in request.auth.token && request.auth.token.email != null && request.auth.token.email_verified == true &&
          resource.data.get('email', '') != '' &&
          resource.data.get('email', '').lower() == request.auth.token.email.lower())
      );
    }
    // 聯絡方式與財務資料不可放在公開的會員資料（應存於 user_private）
    function privateProfileFields() {
      return ['email', 'phone', 'bankAccount', 'surveyData', 'annualSalary', 'password', 'realNameAuthData', 'realNameData'];
    }
    function becomesVerified(field) {
      return request.resource.data.get(field, '') == 'verified' && resource.data.get(field, '') != 'verified';
    }
    // 別的會員（非本人、非管理員）只能改的欄位：評價與統計數字
    function crossUserCounterFields() {
      return ['rating', 'reviewCount', 'acceptedSolutionsCount', 'submittedSolutionsCount', 'acceptanceRate',
              'reputation', 'reputationPoints', 'levelAnswerCounts', 'levelQuestionCounts', 'achievementsCount',
              'weeklyTop10DiscussionCount', 'weeklyTop10SolutionCount', 'weeklyTop10Honors', 'updatedAt'];
    }
    function notSelfVerified() {
      return request.resource.data.get('verifiedBadge', null) in [null, false, ''] &&
        request.resource.data.get('verifiedExpert', false) != true &&
        request.resource.data.get('realNameAuthStatus', '') != 'verified' &&
        request.resource.data.get('expertCertStatus', '') != 'verified';
    }
    match /users/{userId} {
      allow read: if true;
      // 建立會員資料：只能建立自己的（文件編號是登入帳號，或 authUid 是自己），且不能一開始就是已認證
      allow create: if isAdmin() || (
        isSignedIn() &&
        (request.auth.uid == userId || request.resource.data.get('authUid', '') == request.auth.uid) &&
        notSelfVerified() &&
        !request.resource.data.keys().hasAny(privateProfileFields()) &&
        request.resource.data.get('balance', 0) == 0 &&
        request.resource.data.get('withheldPoints', 0) == 0 &&
        request.resource.data.get('role', '') != 'admin' &&
        request.resource.data.get('accountType', '') != 'admin' &&
        request.resource.data.get('isBlocked', false) == false
      );
      allow update: if isAdmin() || (
        isUserOwner(userId) &&
        !request.resource.data.keys().hasAny(privateProfileFields()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields()) &&
        request.resource.data.get('role', '') != 'admin' &&
        request.resource.data.get('accountType', '') != 'admin' &&
        !becomesVerified('realNameAuthStatus') &&
        !becomesVerified('expertCertStatus') &&
        !(request.resource.data.get('verifiedExpert', false) == true && resource.data.get('verifiedExpert', false) != true) &&
        (!('verifiedBadge' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.get('verifiedBadge', null) in [null, false, ''])
      ) || (
        isSignedIn() &&
        !request.resource.data.keys().hasAny(privateProfileFields()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(crossUserCounterFields())
      );
      allow delete: if isAdmin();
    }

    // 認證審核資料（含專家證明）：本人與管理員可讀；本人不能把自己改成已認證
    match /certifications/{certId} {
      allow read: if isAdmin() || ownsUserDoc(certId);
      allow create, update: if isAdmin() || (ownsUserDoc(certId) &&
        request.resource.data.get('realNameAuthStatus', '') != 'verified' &&
        request.resource.data.get('expertCertStatus', '') != 'verified' &&
        request.resource.data.get('status', '') != 'verified');
      allow delete: if isAdmin();
    }

    // 稽核紀錄：前端只寫不讀；只有管理員能讀與刪
    match /audit_logs/{logId} {
      allow read, delete: if isAdmin();
      allow create, update: if true;
    }

    // 客服工單與客服對話：提出者本人（userAuthUid）與管理員能讀；
    // 未登入訪客可留單，但讀不到任何人的工單
    function isGuestSupportDoc(d) {
      return d.get('userAuthUid', '') == '' && d.get('userId', '') in ['user-guest', 'guest', ''];
    }
    match /customer_support_tickets/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userAuthUid', '') == request.auth.uid);
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.get('userAuthUid', '') == request.auth.uid) ||
        isGuestSupportDoc(request.resource.data);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.get('userAuthUid', '') == request.auth.uid &&
          request.resource.data.get('userAuthUid', '') == request.auth.uid) ||
        (isGuestSupportDoc(resource.data) && isGuestSupportDoc(request.resource.data));
      allow delete: if isAdmin();
    }
    match /customer_support_conversations/{convId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userAuthUid', '') == request.auth.uid);
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.get('userAuthUid', '') == request.auth.uid) ||
        isGuestSupportDoc(request.resource.data);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.get('userAuthUid', '') == request.auth.uid &&
          request.resource.data.get('userAuthUid', '') == request.auth.uid) ||
        (isGuestSupportDoc(resource.data) && isGuestSupportDoc(request.resource.data));
      allow delete: if isAdmin();
    }

    // 3. 互動通知與評價體系類 (Engagement, Notifications & Reviews)
    // 通知：收件人本人、全站廣播（userId == 'all'）與管理員能讀
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.recipientAuthUid == request.auth.uid ||
        resource.data.userId == 'all'
      ));
      // 任何登入會員都能發通知給別人，但寄件人必須是自己；全站廣播限管理員
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('senderAuthUid', '') == request.auth.uid &&
        request.resource.data.get('userId', '') != 'all'
      );
      // 收件人只能改已讀狀態
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('recipientAuthUid', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('recipientAuthUid', '') == request.auth.uid);
    }

    // 收藏與按讚紀錄：只有本人與管理員
    match /bookmarks/{userId} {
      allow read, write: if isAdmin() || ownsUserDoc(userId);
    }

    // 專家名錄：所有人可讀；本人可更新自己的介紹，但不能自己加認證標章
    match /solvers/{solverId} {
      allow read: if true;
      allow create: if isAdmin() || (ownsUserDoc(solverId) &&
        request.resource.data.get('verifiedBadge', false) in [null, false, ''] &&
        request.resource.data.get('verifiedExpert', false) != true);
      allow update: if isAdmin() || (ownsUserDoc(solverId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedBadge', 'verifiedExpert', 'tier', 'rating', 'reviewCount']));
      allow delete: if isAdmin();
    }

    // 4. 法律合規與平台設定類 (Compliance & Platform Settings)
    match /terms_agreements/{agreementId} {
      allow read, write: if isAdmin() || ownsUserDoc(agreementId);
    }

    // 平台設定：所有人可讀；只有管理員能改（流量統計、永久刪除清單由伺服器服務帳戶寫入）
    match /platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 其他集合（創星季提案、功能使用統計、上線紀錄、在線人數等）：
    // 一律由伺服器服務帳戶寫入；前端只保留公開提案與連線測試的讀取，其餘只有管理員
    match /competition_proposals/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /_connection_test/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /{collectionId}/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
