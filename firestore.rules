rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 安全輔助函式 =====
    function isSignedIn() {
      return request.auth != null;
    }
    // 管理員：/admins/{uid}（只能從 Firebase Console 或後端建立）、Custom Claims，
    // 或「已驗證」的管理員 Email（與 Vercel 的 ADMIN_EMAILS 保持一致）
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (request.auth.token.email_verified == true &&
          request.auth.token.email in ['john25893619@gmail.com'])
      );
    }

    // 管理員名單：任何前端都不能寫入，避免自我提權
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 實名認證個資：僅本人與管理員可讀寫
    match /user_private/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // 1. 業務核心與交易類 (Core Business & Transactions)
    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /answers/{answerId} {
      allow read, write: if true;
    }

    // 交易紀錄：只有交易相關人（partyAuthUids）與管理員能讀
    match /transactions/{txId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.partyAuthUids);
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid in request.resource.data.get('partyAuthUids', []));
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid in request.resource.data.get('partyAuthUids', []) &&
        (request.auth.uid in resource.data.get('partyAuthUids', []) || !('partyAuthUids' in resource.data))
      );
      allow delete: if isAdmin();
    }

    // 私訊：只有對話雙方（participantAuthUids）與管理員能讀寫
    match /conversations/{convId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.participantAuthUids);
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid in request.resource.data.get('participantAuthUids', []));
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid in request.resource.data.get('participantAuthUids', []) &&
        (request.auth.uid in resource.data.get('participantAuthUids', []) || !('participantAuthUids' in resource.data))
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.get('participantAuthUids', []));
    }

    // 2. 用戶身分與審核治理類 (Identity, Verification & Governance)
    // 點數帳本與預扣紀錄：只有伺服器（服務帳戶）能寫；管理員可讀
    match /points_ledger/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /points_escrow/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 會員資料：所有人可讀；點數與權限欄位只能由伺服器帳本（服務帳戶）或管理員異動
    function protectedUserFields() {
      return ['balance', 'withheldPoints', 'pendingEarnings', 'tipReceivablesPoints', 'thisWeekTipPoints',
              'totalWithdrawn', 'isBlocked', 'blockedReason', 'blockedUntil', 'blockedAt', 'blockedByAdminName',
              'adminSites', 'isSiteAAdmin', 'isSiteBAdmin', 'adminIdentityBadge', 'isInitialAdmin',
              'subscriptionTier', 'subscriptionExpiresAt'];
    }
    // 身分欄位：只有本人能改
    function identityUserFields() {
      return ['name', 'avatar', 'email', 'username', 'phone', 'bio', 'title', 'authUid', 'memberId',
              'accountType', 'role', 'realNameAuthStatus', 'expertCertStatus', 'verifiedExpert'];
    }
    function isUserOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        resource.data.get('authUid', '') == request.auth.uid ||
        ('email' in request.auth.token && request.auth.token.email != null && resource.data.get('email', '') != '' &&
          resource.data.get('email', '').lower() == request.auth.token.email.lower())
      );
    }
    function becomesVerified(field) {
      return request.resource.data.get(field, '') == 'verified' && resource.data.get(field, '') != 'verified';
    }
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('balance', 0) == 0 &&
        request.resource.data.get('withheldPoints', 0) == 0 &&
        request.resource.data.get('role', '') != 'admin' &&
        request.resource.data.get('accountType', '') != 'admin' &&
        request.resource.data.get('isBlocked', false) == false
      );
      allow update: if isAdmin() || (
        isUserOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields()) &&
        request.resource.data.get('role', '') != 'admin' &&
        request.resource.data.get('accountType', '') != 'admin' &&
        !becomesVerified('realNameAuthStatus') &&
        !becomesVerified('expertCertStatus') &&
        !(request.resource.data.get('verifiedExpert', false) == true && resource.data.get('verifiedExpert', false) != true)
      ) || (
        isSignedIn() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields().concat(identityUserFields()))
      );
      allow delete: if isAdmin();
    }

    match /certifications/{certId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 3. 互動通知與評價體系類 (Engagement, Notifications & Reviews)
    // 通知：收件人本人、全站廣播（userId == 'all'）與管理員能讀
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.recipientAuthUid == request.auth.uid ||
        resource.data.userId == 'all'
      ));
      // 任何登入會員都能發通知給別人，但寄件人必須是自己；全站廣播限管理員
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.get('senderAuthUid', '') == request.auth.uid &&
        request.resource.data.get('userId', '') != 'all'
      );
      // 收件人只能改已讀狀態
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.get('recipientAuthUid', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.get('recipientAuthUid', '') == request.auth.uid);
    }

    match /bookmarks/{userId} {
      allow read, write: if true;
    }

    match /solvers/{solverId} {
      allow read, write: if true;
    }

    // 4. 法律合規與平台設定類 (Compliance & Platform Settings)
    match /terms_agreements/{agreementId} {
      allow read, write: if true;
    }

    match /platform_settings/{settingId} {
      allow read, write: if true;
    }

    // Default fallback
    // 注意：Firestore 規則是「任一條允許即放行」，因此萬用規則必須排除上方受保護的集合
    match /{collectionId}/{document=**} {
      allow read, write: if !(collectionId in ['admins', 'user_private', 'transactions', 'conversations', 'notifications', 'points_ledger', 'points_escrow']);
    }
  }
}
