rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. 業務核心與交易類 (Core Business & Transactions)
    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /answers/{answerId} {
      allow read, write: if true;
    }

    match /transactions/{txId} {
      allow read, write: if true;
    }

    match /conversations/{convId} {
      allow read, write: if true;
    }

    // 2. 用戶身分與審核治理類 (Identity, Verification & Governance)
    match /users/{userId} {
      allow read, write: if true;
    }

    match /certifications/{certId} {
      allow read, write: if true;
    }

    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 3. 互動通知與評價體系類 (Engagement, Notifications & Reviews)
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /bookmarks/{userId} {
      allow read, write: if true;
    }

    match /solvers/{solverId} {
      allow read, write: if true;
    }

    // 4. 法律合規與平台設定類 (Compliance & Platform Settings)
    match /terms_agreements/{agreementId} {
      allow read, write: if true;
    }

    match /platform_settings/{settingId} {
      allow read, write: if true;
    }

    // 5. 平台手冊與自訂清單檔案 (Platform Manual & Custom Uploaded Files)
    match /platform_manual_files/{fileId} {
      allow read, write: if true;
    }

    // 6. 競賽專用集合 (IdeaX Innovation Challenge Collections)
    match /challenge_proposals/{proposalId} {
      allow read, write: if true;
    }

    match /challenge_wallets/{walletId} {
      allow read, write: if true;
    }

    match /challenge_ambassadors/{ambassadorId} {
      allow read, write: if true;
    }

    match /challenge_experts/{expertId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
