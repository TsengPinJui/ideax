{
  "rules": {
    ".read": false,
    ".write": false,
    "kingdomPresence": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['n', 'x', 'z', 'r', 't'])",
        "n": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 64" },
        "x": { ".validate": "newData.isNumber() && newData.val() > -1000 && newData.val() < 1000" },
        "y": { ".validate": "newData.isNumber() && newData.val() > -50 && newData.val() < 100" },
        "z": { ".validate": "newData.isNumber() && newData.val() > -1000 && newData.val() < 1000" },
        "r": { ".validate": "newData.isNumber()" },
        "t": { ".validate": "newData.val() === now" },
        "$other": { ".validate": false }
      }
    }
  }
}
