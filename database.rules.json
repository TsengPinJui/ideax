{
  "rules": {
    ".read": false,
    ".write": false,
    "kingdomPresence": {
      ".read": true,
      "$uid": {
        "$sid": {
          ".write": "$uid.length <= 64 && $sid.length <= 40",
          ".validate": "!newData.exists() || newData.hasChildren(['n', 'x', 'z', 'r', 't'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "c": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 64"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() > -5000 && newData.val() < 5000"
          },
          "y": {
            ".validate": "newData.isNumber() && newData.val() > -500 && newData.val() < 500"
          },
          "z": {
            ".validate": "newData.isNumber() && newData.val() > -5000 && newData.val() < 5000"
          },
          "r": {
            ".validate": "newData.isNumber()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "kingdomBoats": {
      "slots": {
        ".read": true,
        "$i": {
          ".write": "$i.matches(/^([0-9]|1[0-9]|2[0-4])$/)",
          ".validate": "!newData.exists() || newData.hasChildren(['o', 'x', 'z', 'r', 't'])",
          "o": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "on": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "p": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "pn": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "x": {
            ".validate": "newData.isNumber() && newData.val() > -5000 && newData.val() < 5000"
          },
          "z": {
            ".validate": "newData.isNumber() && newData.val() > -5000 && newData.val() < 5000"
          },
          "r": {
            ".validate": "newData.isNumber()"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "d": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "w": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "queue": {
        ".read": true,
        "$k": {
          ".write": "$k.length <= 64",
          ".validate": "!newData.exists() || newData.hasChildren(['n', 't'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "s": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
