    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.16",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "0.160.0",
    "vite": "^8.3.0",
